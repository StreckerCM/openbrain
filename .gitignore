.env
*.swp
*.swo
docker-compose.override.yml
mcp-gateway-pins-known-good*.txt
requirements.txt.unpinned-bak
.worktrees/
.superpowers/

# Working exports staged for review before being pushed back to the
# knowledge base via update_knowledge. The database is the source of
# truth, so committing these would duplicate it and drift. They also
# contain third-party licensed material (OWSG toolgroup parameters, SPE
# paper equations) that should not land in a public repo.
knowledge-review/
*.dump
*.png

# Local test virtualenv for mcp-gateway
mcp-gateway/.venv/

# Python bytecode and pytest cache
__pycache__/
.pytest_cache/

# Cloudflare tunnel credentials — never commit
cloudflared/*.json

# Project-scope MCP config. OpenBrain is configured at user scope in
# ~/.claude.json instead, and the README deliberately advises keeping bearer
# tokens out of a tracked file. Ignored so a project-scope config carrying a
# credential cannot be committed by accident. Remove this line if a shared,
# token-free project config is ever wanted.
.mcp.json
